{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cf:frontend:dev": "wrangler pages dev dist --config wrangler.jsonc",
    "cf:backend:check": "wrangler deploy --config server/wrangler.jsonc --env staging --dry-run",
    "cf:backend:dev": "wrangler dev --config server/wrangler.jsonc --env staging",
    "cf:backend:deploy:staging": "wrangler deploy --config server/wrangler.jsonc --env staging",
    "cf:backend:tail:staging": "wrangler tail --config server/wrangler.jsonc --env staging",
    "contract:build": "blueprint build LockVault && blueprint build MerkleClaim && blueprint build TestJetton",
    "contract:test": "blueprint test",
    "test": "jest",
    "contract:deploy:testnet-jetton": "tsx scripts/deployTestnetJetton.ts",
    "contract:deploy:testnet": "tsx scripts/deployTestnetContracts.ts",
    "contract:jetton-wallets:testnet": "tsx scripts/deriveTestnetJettonWallets.ts",
    "contract:configure:testnet": "tsx scripts/configureTestnetContracts.ts",
    "contract:deploy:lock-vault:mainnet": "blueprint run deployLockVault --mainnet --tonconnect",
    "contract:deploy:merkle-claim:mainnet": "blueprint run deployMerkleClaim --mainnet --tonconnect",
    "contract:canary:deposit:testnet": "tsx scripts/sendTestnetDeposit.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tonconnect/ui-react": "^2.4.4",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@tact-lang/compiler": "^1.6.13",
    "@ton-community/func-js": "^0.11.0",
    "@ton/blueprint": "^0.44.2",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/sandbox": "^0.41.0",
    "@ton/test-utils": "^0.12.0",
    "@ton/tolk-js": "^1.3.0",
    "@ton/ton": "^16.2.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jest": "^30.3.0",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.84.1"
  }
}
