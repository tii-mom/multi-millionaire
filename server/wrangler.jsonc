{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "multi-millionaire-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "env": {
    "staging": {
      "name": "multi-millionaire-api-staging",
      "vars": {
        "NODE_ENV": "staging",
        "CORS_ALLOWED_ORIGINS": "https://staging.multi-millionaire-staging.pages.dev,https://multi-millionaire-staging.pages.dev",
        "ADMIN_EMAILS": "admin@example.com",
        "HIGH_RISK_DEPOSIT_THRESHOLD": "1000000",
        "CHAIN_ID": "ton-testnet",
        "CHAIN_INTEGRATION_ENABLED": "false",
        "CHAIN_READ_ONLY_ENABLED": "false",
        "CHAIN_INDEXER_ENABLED": "false",
        "CHAIN_MAINLINE_WRITES_ENABLED": "false",
        "WALLET_BINDING_ENABLED": "false",
        "RECEIPT_VERIFICATION_ENABLED": "false",
        "TOKEN_ADDRESS": "",
        "LOCK_VAULT_ADDRESS": "",
        "ORACLE_ADDRESS": "",
        "REWARD_DISTRIBUTOR_ADDRESS": "",
        "CHAIN_RECEIPT_VERIFIER": "disabled",
        "MERKLE_CLAIM_VERIFIER": "disabled"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "88b8cd7fd84e4064ad29b43a16c579f2" }]
    },
    "production": {
      "name": "multi-millionaire-api-production",
      "workers_dev": true,
      "vars": {
        "NODE_ENV": "production",
        "CORS_ALLOWED_ORIGINS": "https://mm.72h.lol",
        "ADMIN_OPERATIONS_ENABLED": "false",
        "ADMIN_EMAILS": "",
        "RISK_REVIEW_ENABLED": "false",
        "HIGH_RISK_DEPOSIT_THRESHOLD": "0",
        "CHAIN_ID": "ton-mainnet",
        "CHAIN_RPC_URL": "",
        "TON_TRANSACTIONS_API_URL": "",
        "CHAIN_INTEGRATION_ENABLED": "false",
        "CHAIN_READ_ONLY_ENABLED": "false",
        "CHAIN_INDEXER_ENABLED": "false",
        "CHAIN_MAINLINE_WRITES_ENABLED": "false",
        "WALLET_BINDING_ENABLED": "false",
        "RECEIPT_VERIFICATION_ENABLED": "false",
        "CHAIN_ADMIN_ADDRESS": "UQCxJ05yeawVWlsN5SfJ-obajgh2lFffR-O7ebH_s_wqQfRq",
        "TOKEN_ADDRESS": "EQBGIzEDvvKObStrcVb6i5Z1-8uYZYtUrYzF2rFZU7xUAXVg",
        "TOKEN_DECIMALS": "9",
        "LOCK_VAULT_ADDRESS": "",
        "LOCK_VAULT_JETTON_WALLET_ADDRESS": "",
