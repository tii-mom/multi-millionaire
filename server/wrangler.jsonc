{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "multi-millionaire-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "env": {
    "staging": {
      "name": "multi-millionaire-api-staging",
      "vars": {
        "NODE_ENV": "staging",
        "CORS_ALLOWED_ORIGINS": "https://staging.multi-millionaire-staging.pages.dev",
        "ADMIN_EMAILS": "admin@example.com",
        "HIGH_RISK_DEPOSIT_THRESHOLD": "1000000",
        "CHAIN_ID": "ton-mainnet",
        "TOKEN_ADDRESS": "EQDTESTTOKENADDRESS000000000000000000000000000000000",
        "LOCK_VAULT_ADDRESS": "EQDTESTLOCKVAULTADDRESS0000000000000000000000000000",
        "ORACLE_ADDRESS": "EQDTESTORACLEADDRESS00000000000000000000000000000000",
        "REWARD_DISTRIBUTOR_ADDRESS": "EQDTESTREWARDDISTRIBUTORADDRESS0000000000000000000"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "88b8cd7fd84e4064ad29b43a16c579f2" }]
    },
    "production": {
      "name": "multi-millionaire-api-production",
      "vars": {
        "NODE_ENV": "production",
        "CORS_ALLOWED_ORIGINS": "https://multi-millionaire.pages.dev",
        "ADMIN_EMAILS": "<set-production-admin-emails>",
        "HIGH_RISK_DEPOSIT_THRESHOLD": "<set-production-risk-threshold>",
        "CHAIN_ID": "ton-mainnet",
        "CHAIN_INTEGRATION_ENABLED": "false",
        "CHAIN_READ_ONLY_ENABLED": "false",
        "CHAIN_INDEXER_ENABLED": "false",
        "CHAIN_MAINLINE_WRITES_ENABLED": "false",
        "WALLET_BINDING_ENABLED": "false",
        "RECEIPT_VERIFICATION_ENABLED": "false",
        "TOKEN_ADDRESS": "<set-production-token-address>",
        "LOCK_VAULT_ADDRESS": "<set-production-lock-vault-address>",
        "ORACLE_ADDRESS": "<set-production-oracle-address>",
        "REWARD_DISTRIBUTOR_ADDRESS": "<set-production-reward-distributor-address>"
      }
      // Add the production Hyperdrive binding only after the production Neon
      // database is provisioned, migrated, seeded deliberately, and isolated
      // from staging:
      // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<production-hyperdrive-id>" }]
    }
  }
}
