{
  "name": "multi-millionaire-api-production",
  "version": "1.0.0",
  "description": "Production-ready API server for the 72H social‑lock platform.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "check:env": "ts-node src/scripts/checkEnv.ts",
    "check:schema": "ts-node src/scripts/checkSchema.ts",
    "preflight:migration:staging": "ts-node src/scripts/preflightStagingMigration.ts",
    "migrate:up": "ts-node src/scripts/migrate.ts up",
    "migrate:reset": "ts-node src/scripts/migrate.ts reset",
    "seed:dev": "ts-node src/scripts/seedDev.ts",
    "smoke": "ts-node src/scripts/smoke.ts",
    "smoke:staging-mutating": "ts-node src/scripts/smoke.ts",
    "smoke:production": "PRODUCTION_SMOKE_PROFILE=infra ts-node src/scripts/productionSmoke.ts",
    "smoke:production-readonly": "PRODUCTION_SMOKE_PROFILE=infra ts-node src/scripts/productionSmoke.ts",
    "smoke:production-gray-readonly": "PRODUCTION_SMOKE_PROFILE=gray ts-node src/scripts/productionSmoke.ts",
    "smoke:production-canary": "node -e \"if (process.env.PRODUCTION_CANARY_APPROVED !== 'true') { console.error('PRODUCTION_CANARY_APPROVED=true is required for production canary smoke'); process.exit(1); }\" && ts-node src/scripts/smoke.ts",
    "season-war:export": "ts-node src/scripts/exportSeasonWar.ts",
    "season-war:rehearsal:v2-large": "ts-node src/scripts/generateSeasonWarV2LargeRehearsal.ts"
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.15",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.5.9",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.6.2",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
